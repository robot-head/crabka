  (spso: Int64.t) (log_start: Int64.t) (return (x: Int64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- Int64.ge spso ([%#sbroker] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb3) | br1 -> {_9} (! bb1) ] ]
  | bb1 = s0 [ s0 = max_i64 [%#sbroker'0] {spso} {log_start} (fun (_x: Int64.t) -> [ &base <- _x ] s1) | s1 = bb4 ]
  | bb3 = s0 [ s0 = [ &base <- log_start ] s1 | s1 = bb4 ]
  | bb4 = s0
    [ s0 = saturating_sub [%#sbroker'1] {hwm} {base} (fun (_x: Int64.t) -> [ &_13 <- _x ] s1)
    | s1 = max_i64 [%#sbroker'3] {_13} {[%#sbroker'2] (0: Int64.t)} (fun (_x: Int64.t) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & hwm: Int64.t = hwm
  | & spso: Int64.t = spso
  | & log_start: Int64.t = log_start
  | & base: Int64.t = Any.any_l ()
  | & _9: bool = Any.any_l ()
  | & _13: Int64.t = Any.any_l () ])
  [ return (result: Int64.t) -> {[@stop_split] [@expl:effective_share_backlog ensures] [%#sbroker'4] Int64.to_int result
    = effective_share_backlog_model hwm spso log_start}
    (! return {result}) ]
