  | bb6 = s0 [ s0 = [ &effective_lso'0 <- lso ] s1 | s1 = bb10 ]
  | bb7 = s0 [ s0 = [ &effective_lso'0 <- hw ] s1 | s1 = bb10 ]
  | bb9 = s0 [ s0 = [ &effective_lso'0 <- lso ] s1 | s1 = bb10 ]
  | bb10 = any [ br0 -> {is_follower = false} (! bb12) | br1 -> {is_follower} (! bb11) ]
  | bb11 = s0 [ s0 = [ &response_hw'0 <- log_end ] s1 | s1 = bb13 ]
  | bb12 = s0 [ s0 = [ &response_hw'0 <- hw ] s1 | s1 = bb13 ]
  | bb13 = any [ br0 -> {read_committed = false} (! bb16) | br1 -> {read_committed} (! bb14) ]
  | bb14 = any [ br0 -> {is_follower = false} (! bb15) | br1 -> {is_follower} (! bb16) ]
  | bb15 = s0 [ s0 = [ &response_lso'0 <- effective_lso'0 ] s1 | s1 = bb20 ]
  | bb16 = any [ br0 -> {is_follower = false} (! bb18) | br1 -> {is_follower} (! bb17) ]
  | bb17 = s0 [ s0 = [ &response_lso'0 <- log_end ] s1 | s1 = bb20 ]
  | bb18 = s0 [ s0 = [ &response_lso'0 <- hw ] s1 | s1 = bb20 ]
  | bb20 = any [ br0 -> {is_follower = false} (! bb22) | br1 -> {is_follower} (! bb21) ]
  | bb21 = s0 [ s0 = [ &limit_offset'0 <- log_end ] s1 | s1 = bb26 ]
  | bb22 = any [ br0 -> {read_committed = false} (! bb24) | br1 -> {read_committed} (! bb23) ]
  | bb23 = s0 [ s0 = [ &limit_offset'0 <- effective_lso'0 ] s1 | s1 = bb26 ]
  | bb24 = s0 [ s0 = [ &limit_offset'0 <- hw ] s1 | s1 = bb26 ]
  | bb26 = s0
