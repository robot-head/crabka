    | s1 = any [ br0 -> {out_of_range'0 = false} (! bb27) | br1 -> {out_of_range'0} (! bb28) ] ]
  | bb28 = s0 [ s0 = [ &_66 <- [%#sbroker] false ] s1 | s1 = bb29 ]
  | bb27 = s0 [ s0 = [ &_66 <- Int64.ge fetch_offset upper_bound ] s1 | s1 = bb29 ]
  | bb29 = any [ br0 -> {read_committed = false} (! bb31) | br1 -> {read_committed} (! bb30) ]
  | bb30 = s0 [ s0 = [ &_72 <- not is_follower ] s1 | s1 = bb32 ]
  | bb31 = s0 [ s0 = [ &_72 <- [%#sbroker'0] false ] s1 | s1 = bb32 ]
  | bb32 = s0
