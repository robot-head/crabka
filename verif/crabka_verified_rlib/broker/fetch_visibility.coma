                        empty = _66;
                        limit_offset = limit_offset'0;
                        effective_lso = effective_lso'0;
                        read_committed_aborts = _72;
                        response_hw = response_hw'0;
                        response_lso = response_lso'0 } ] s1
    | s1 = return {_ret} ] ]
  [ & _ret: t_FetchVisibility = Any.any_l ()
  | & is_follower: bool = is_follower
  | & read_committed: bool = read_committed
  | & log_start: Int64.t = log_start
  | & hw: Int64.t = hw
  | & lso: Int64.t = lso
  | & log_end: Int64.t = log_end
  | & fetch_offset: Int64.t = fetch_offset
