predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let fetch_visibility [#"/workspace/crates/verified/src/broker.rs" 41 0 49 20] (is_follower: bool) (read_committed: bool)
  (log_start: Int64.t) (hw: Int64.t) (lso: Int64.t) (log_end: Int64.t) (fetch_offset: Int64.t)
  (return (x: t_FetchVisibility)) = {[@stop_split] [@expl:fetch_visibility requires] [%#sbroker'1] 0
    <= Int64.to_int log_start
  /\ Int64.to_int log_start <= Int64.to_int hw /\ Int64.to_int hw <= Int64.to_int log_end}
  (! bb0
  [ bb0 = any [ br0 -> {is_follower = false} (! bb2) | br1 -> {is_follower} (! bb1) ]
