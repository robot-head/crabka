    /\ ([@stop_split] [@expl:retain_decision ensures #7] [%#scompaction'8] forall h: Int64.t. not batch.is_control
        /\ rec'.has_key /\ is_newest_for_key /\ not rec'.has_value /\ batch.existing_horizon = Some h
      -> result = (if Int64.to_int now_ms >= Int64.to_int h then Delete else Keep))}
    (! return {result}) ]
