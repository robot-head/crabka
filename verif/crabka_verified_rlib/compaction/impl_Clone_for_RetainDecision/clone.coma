  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_RetainDecision = Any.any_l () | & self: t_RetainDecision = self ])
  [ return (result: t_RetainDecision) -> (! return {result}) ]
