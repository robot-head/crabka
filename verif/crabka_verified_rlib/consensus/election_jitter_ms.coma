let wrapping_mul (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:wrapping_mul ensures] [%#snum] result = UInt64.mul self_ rhs}
    (! return {result}) ]

let from_u64 (small: UInt32.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = UInt64.of_int (UInt32.t'int small)}
