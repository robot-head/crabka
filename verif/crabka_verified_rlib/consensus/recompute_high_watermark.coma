let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

function hwm_member_at [#"/work/crates/verified/src/consensus.rs" 11 0 11 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'25] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/work/crates/verified/src/consensus.rs" 20 0 20 76] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [count_ge_prefix log_end s v limit]. count_ge_prefix log_end s v limit
    = ([%#sconsensus'30] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) + (if hwm_member_at log_end s (limit - 1) >= v then 1 else 0)
    )

function count_ge [#"/work/crates/verified/src/consensus.rs" 34 0 34 57] (log_end: int) (s: Seq.seq Int64.t) (v: int) : int

axiom count_ge_def: forall log_end: int, s: Seq.seq Int64.t, v: int [count_ge log_end s v]. count_ge log_end s v
    = ([%#sconsensus'24] count_ge_prefix log_end s v (Seq.length s + 1))

let candidate_has_majority (log_end: Int64.t) (follower_offsets: Slice64.slice Int64.t) (cand: Int64.t)
  (majority: UInt64.t) (return (x: bool)) = {[@stop_split] [@expl:candidate_has_majority requires] [%#sconsensus'21] 1
    <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:candidate_has_majority ensures] [%#sconsensus'22] result
    = (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int cand) >= UInt64.t'int majority)}
    (! return {result}) ]

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

let lemma_hwm_member_maximal (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (best: Int64.t)
  (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_member_maximal requires] ([@stop_split] [@expl:lemma_hwm_member_maximal requires #0] [%#sconsensus'26] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1)
  /\ ([@stop_split] [@expl:lemma_hwm_member_maximal requires #1] [%#sconsensus'27] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view s) + 1
      /\ count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k)
      >= UInt64.t'int majority -> hwm_member_at (Int64.to_int log_end) (Slice64.view s) k <= Int64.to_int best)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_member_maximal ensures] [%#sconsensus'28] forall v: int. count_ge (Int64.to_int log_end) (Slice64.view s) v
        >= UInt64.t'int majority -> v <= Int64.to_int best}
    (! return {result}) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] deep_model_i64 result
      >= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] deep_model_i64 result >= deep_model_i64 o)
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let recompute_high_watermark [#"/work/crates/verified/src/consensus.rs" 267 0 273 8] (log_end: Int64.t)
