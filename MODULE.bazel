"""Crabka's hermetic Bazel module."""

module(
    name = "crabka",
    version = "0.3.6",
)

bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "bazel-diff", version = "27.0.0")
bazel_dep(name = "openssl", version = "3.5.5.bcr.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "34.0.bcr.1")
bazel_dep(name = "rules_rs", version = "0.0.98")
bazel_dep(name = "rules_apko", version = "1.5.52")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")

apko = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko.toolchain(apko_version = "v1.2.25")
apko.translate_lock(
    name = "crabka_runtime",
    lock = "//packaging/apko:runtime-base.lock.json",
)
use_repo(apko, "apko_toolchains", "crabka_runtime")

register_toolchains("@apko_toolchains//:all")

# ---------------------------------------------------------------------------
# Rust toolchain — pinned to the workspace channel (rust-toolchain.toml).
# ---------------------------------------------------------------------------
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.97.1",
)
use_repo(toolchains, "default_rust_toolchains")

# Compatibility facade for rules_rs features that are still exposed by the
# patched rules_rust repository (build scripts, prost, rustfmt and clippy).
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

wasm_bindgen = use_extension("@rules_rs//rs:rules_rust_wasm_bindgen.bzl", "rules_rust_wasm_bindgen")
use_repo(wasm_bindgen, "rules_rust_wasm_bindgen")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
    "//platforms:wasm_bindgen_toolchain",
)

# ---------------------------------------------------------------------------
# Third-party crates, spliced straight from the Cargo workspace.
#
# `crate_universe` needs *every* workspace member's manifest to reconstruct the
# workspace before resolving against Cargo.lock, so all members are listed —
# even the ones that don't yet have hand-written BUILD targets. In-scope client
# crates own their Cargo.toml in their own package (`//crates/<x>:Cargo.toml`);
# the remaining members are exported en masse from `//crates:BUILD.bazel`
# (`//crates:<x>/Cargo.toml`).
#
# The `sspi` GSSAPI dependency is a normal crates.io dependency and is included
# through the same Cargo.lock splice as the rest of the workspace.
# ---------------------------------------------------------------------------
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.annotation(
    build_script_data = ["@openssl//:gen_dir"],
    build_script_env = {
        "OPENSSL_DIR": "$(execpath @openssl//:gen_dir)",
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "1",
    },
    crate = "openssl-sys",
    data = ["@openssl//:gen_dir"],
    gen_build_script = "on",
)
crate.annotation(
    crate = "wasm-bindgen-cli",
    gen_binaries = ["wasm-bindgen"],
)
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = ["offline"],
)
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)

inject_repo(crate, "openssl")

use_repo(crate, "crates")
