"""Root package: the public, re-exported Crabka client surface.

These aliases are the stable names embedders depend on, e.g.
`@crabka//:client_producer`. They forward to the per-crate `rust_library`
targets under //crates/... and //bazel/....
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# --------------------------------------------------------------------------- #
# GSSAPI / Kerberos gate.
#
# The `sspi` git dependency (SASL/GSSAPI) is heavyweight and platform-touchy, so
# it is OFF by default. Flip it with `--//:gssapi=true` (or `--config=gssapi`).
# //crates/security and //crates/client-core select on `:gssapi_enabled` to turn
# the `sspi-keytab` feature (and the `sspi` dep) on.
# --------------------------------------------------------------------------- #
bool_flag(
    name = "gssapi",
    build_setting_default = False,
)

config_setting(
    name = "gssapi_enabled",
    flag_values = {":gssapi": "True"},
)

# --------------------------------------------------------------------------- #
# Re-exported client crates.
# --------------------------------------------------------------------------- #
alias(
    name = "client_core",
    actual = "//crates/client-core",
)

alias(
    name = "client_producer",
    actual = "//crates/client-producer",
)

alias(
    name = "client_consumer",
    actual = "//crates/client-consumer",
)

alias(
    name = "client_admin",
    actual = "//crates/client-admin",
)

alias(
    name = "schema_serde",
    actual = "//crates/schema-serde",
)

alias(
    name = "protocol",
    actual = "//crates/protocol",
)

alias(
    name = "security",
    actual = "//crates/security",
)

alias(
    name = "compression",
    actual = "//crates/compression",
)

alias(
    name = "metadata",
    actual = "//crates/metadata",
)

# Lean facade bundling the client surface (no polars/arrow/jsonschema; GSSAPI
# gated behind //:gssapi).
alias(
    name = "client_minimal",
    actual = "//bazel/client_minimal:client_minimal",
)
