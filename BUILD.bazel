"""Root package: the public, re-exported Crabka client surface.

These aliases are the stable names embedders depend on, e.g.
`@crabka//:client_producer`. They forward to the per-crate `rust_library`
targets under //crates/... and //bazel/....
"""

load("@rules_rust//rust:toolchain.bzl", "current_rustfmt_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".creusot-version",
    "Cargo.lock",
    "Cargo.toml",
    ".github/workflows/ci.yml",
    "bazel/patches/rules_rs-build-script-warnings.patch",
    "bazel/integration_test.bzl",
    "deploy/crds/crabka.io_greses.yaml",
    "deploy/crds/crabka.io_grestenants.yaml",
    "deploy/crds/crabka.io_kafkanodepools.yaml",
    "deploy/crds/crabka.io_kafkas.yaml",
    "why3find.json",
])

current_rustfmt_toolchain(name = "rustfmt")

filegroup(
    name = "bench_scenarios",
    srcs = glob(["bench/scenarios/**"]),
    visibility = ["//crates/bench-driver:__pkg__"],
)

filegroup(
    name = "observability_demo_test_data",
    srcs = glob([
        ".bazelrc",
        ".github/workflows/publish-demo-image.yml",
        "demo/observability/**",
    ]) + ["//packaging:test_data"],
    visibility = ["//crates/observability-demo-app:__pkg__"],
)

# --------------------------------------------------------------------------- #
# Re-exported client crates.
# --------------------------------------------------------------------------- #
alias(
    name = "client_core",
    actual = "//crates/client-core",
)

alias(
    name = "client_producer",
    actual = "//crates/client-producer",
)

alias(
    name = "client_consumer",
    actual = "//crates/client-consumer",
)

alias(
    name = "client_admin",
    actual = "//crates/client-admin",
)

alias(
    name = "schema_serde",
    actual = "//crates/schema-serde",
)

alias(
    name = "protocol",
    actual = "//crates/protocol",
)

alias(
    name = "security",
    actual = "//crates/security",
)

alias(
    name = "compression",
    actual = "//crates/compression",
)

alias(
    name = "metadata",
    actual = "//crates/metadata",
)

# Lean facade bundling the client surface (no polars/arrow/jsonschema).
alias(
    name = "client_minimal",
    actual = "//bazel/client_minimal:client_minimal",
)
