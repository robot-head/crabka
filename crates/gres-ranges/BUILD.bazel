load("//:bazel/rust_package.bzl", "rust_package")

filegroup(
    name = "test_harness",
    srcs = glob(["tests/harness/**"]),
    visibility = ["//visibility:public"],
)

rust_package(
    name = "gres-ranges",
    cargo_name = "crabka-gres-ranges",
    compile_data = ["//crates/security:test_fixtures"],
    crate_name = "crabka_gres_ranges",
    lib_test_size = "small",
    test_binaries = {"crabka-gres": "//crates/gres:crabka-gres__bin"},
    test_sizes = {"tso_monotonicity_model": "medium"},
)
