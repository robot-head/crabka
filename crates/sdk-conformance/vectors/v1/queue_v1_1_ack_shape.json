{
  "id": "queue_v1_1_ack_shape",
  "since": { "major": 1, "minor": 1 },
  "steps": [
    {
      "name": "publish ackable queue record",
      "command": {
        "cmd": "publish",
        "topic": "queue-ack",
        "value_b64": "YWNr",
        "headers": []
      },
      "expect": {
        "ok": { "deduplicated": false, "offset": 0, "partition": 0 }
      }
    },
    {
      "name": "acquire ackable queue record",
      "command": {
        "cmd": "queue_acquire",
        "topic": "queue-ack",
        "group": "queue-workers",
        "max": 1,
        "lock_duration_ms": 30000
      },
      "expect": {
        "ok": {
          "session_id": "queue-session-1",
          "messages": [
            {
              "message_id": "queue-ack:0:0",
              "topic": "queue-ack",
              "partition": 0,
              "offset": 0,
              "value_b64": "YWNr",
              "headers": [],
              "delivery_count": 1
            }
          ]
        }
      }
    },
    {
      "name": "ack returns per-entry success shape",
      "command": {
        "cmd": "queue_acknowledge",
        "session_id": "queue-session-1",
        "entries": [{ "message_id": "queue-ack:0:0", "ack_type": "accept" }]
      },
      "expect": {
        "ok": {
          "results": [{ "message_id": "queue-ack:0:0", "error": null }]
        }
      }
    }
  ]
}
