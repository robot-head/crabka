{
  "id": "filter_delivers_matches_only",
  "since": { "major": 1, "minor": 0 },
  "steps": [
    {
      "name": "publish non matching structured value",
      "command": {
        "cmd": "publish",
        "topic": "filtered",
        "value_b64": "eyJraW5kIjoic2tpcCJ9",
        "headers": []
      },
      "expect": {
        "ok": {
          "deduplicated": false,
          "offset": 0,
          "partition": 0
        }
      }
    },
    {
      "name": "publish matching structured value",
      "command": {
        "cmd": "publish",
        "topic": "filtered",
        "value_b64": "eyJraW5kIjoia2VlcCJ9",
        "headers": []
      },
      "expect": {
        "ok": {
          "deduplicated": false,
          "offset": 1,
          "partition": 0
        }
      }
    },
    {
      "name": "subscribe with equals filter",
      "command": {
        "cmd": "subscribe",
        "topics": ["filtered"],
        "group": "filtered-reader",
        "filter": {
          "path": "$.kind",
          "op": "equals",
          "value": "keep"
        }
      },
      "expect": {
        "ok": {}
      }
    },
    {
      "name": "filter delivers matching record only",
      "command": {
        "cmd": "next_message",
        "timeout_ms": 20000
      },
      "expect": {
        "message": {
          "topic": "filtered",
          "partition": 0,
          "offset": 1,
          "value_b64": "eyJraW5kIjoia2VlcCJ9",
          "headers": []
        }
      }
    },
    {
      "name": "publish SQL literal escaping match",
      "command": {
        "cmd": "publish",
        "topic": "filtered-literal",
        "value_b64": "eyJraW5kIjoiQzpcXHRtcFxcTydCcmllbiJ9",
        "headers": []
      },
      "expect": {
        "ok": {
          "deduplicated": false,
          "offset": 0,
          "partition": 0
        }
      }
    },
    {
      "name": "subscribe with apostrophe and backslash filter literal",
      "command": {
        "cmd": "subscribe",
        "topics": ["filtered-literal"],
        "group": "filtered-literal-reader",
        "filter": {
          "path": "$.kind",
          "op": "equals",
          "value": "C:\\tmp\\O'Brien"
        }
      },
      "expect": {
        "ok": {}
      }
    },
    {
      "name": "filter literal preserves apostrophe and backslash",
      "command": {
        "cmd": "next_message",
        "timeout_ms": 20000
      },
      "expect": {
        "message": {
          "topic": "filtered-literal",
          "partition": 0,
          "offset": 0,
          "value_b64": "eyJraW5kIjoiQzpcXHRtcFxcTydCcmllbiJ9",
          "headers": []
        }
      }
    },
    {
      "name": "publish non-null value",
      "command": {
        "cmd": "publish",
        "topic": "filtered-null",
        "value_b64": "eyJkZWxldGVkIjpmYWxzZX0=",
        "headers": []
      },
      "expect": {
        "ok": { "deduplicated": false, "offset": 0, "partition": 0 }
      }
    },
    {
      "name": "publish null value",
      "command": {
        "cmd": "publish",
        "topic": "filtered-null",
        "value_b64": "eyJkZWxldGVkIjpudWxsfQ==",
        "headers": []
      },
      "expect": {
        "ok": { "deduplicated": false, "offset": 1, "partition": 0 }
      }
    },
    {
      "name": "subscribe with null filter",
      "command": {
        "cmd": "subscribe",
        "topics": ["filtered-null"],
        "group": "filtered-null-reader",
        "filter": { "path": "$.deleted", "op": "equals", "value": null }
      },
      "expect": { "ok": {} }
    },
    {
      "name": "null filter delivers only null record",
      "command": { "cmd": "next_message", "timeout_ms": 20000 },
      "expect": {
        "message": {
          "topic": "filtered-null",
          "partition": 0,
          "offset": 1,
          "value_b64": "eyJkZWxldGVkIjpudWxsfQ==",
          "headers": []
        }
      }
    }
  ]
}
