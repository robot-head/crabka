load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

# Manifest is consumed by crate_universe (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# NOTE: protocol's build.rs is intentionally NOT run under Bazel. It only
# *validates* that the checked-in `generated/` sources match the `schemas/`
# SHAs (a dev/CI guard) and emits no code, so it is dead weight here — the
# generated wire codecs are consumed directly as `compile_data` below. SHA
# drift is still caught by the Cargo build and CI.

rust_library(
    name = "protocol",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    # The generated wire-codec sources are pulled in at compile time via
    # `include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/...))`.
    compile_data = glob([
        "generated/**",
        "schemas/**",
    ]),
    crate_name = "crabka_protocol",
    # Codec features forwarded to crabka-compression. `arbitrary` (fuzzing
    # helper) is intentionally left off for the client build.
    crate_features = [
        "gzip",
        "snappy",
        "lz4",
        "zstd",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    # The generated sources are pulled in via
    # `include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/..."))`, which
    # needs an *absolute* manifest dir (a relative one resolves against each
    # including file's directory and doubles the path). rules_rust's
    # process_wrapper substitutes `${pwd}` with the absolute exec root at action
    # time, so this points CARGO_MANIFEST_DIR at the in-sandbox package dir where
    # `compile_data` stages generated/ and schemas/.
    # `$$` escapes Bazel's Make-variable pass so the literal `${pwd}` reaches
    # the process_wrapper, which substitutes the absolute exec root.
    rustc_env = {
        "CARGO_MANIFEST_DIR": "$${pwd}/crates/protocol",
    },
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//crates/compression",
    ],
)
