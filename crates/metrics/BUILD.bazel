load("//:bazel/rust_package.bzl", "rust_feature_binary", "rust_package")

filegroup(
    name = "test_support",
    srcs = glob(["tests/support/**"]),
    visibility = ["//visibility:public"],
)

rust_package(
    name = "metrics",
    build_script = True,
    cargo_name = "crabka-metrics",
    crate_name = "crabka_metrics",
    protoc = True,
)

rust_feature_binary(
    name = "crabka-metrics-heap__bin",
    crate_label = ":metrics",
    crate_root = "src/bin/crabka-metrics.rs",
    features = ["heap-profiling"],
    deps = ["@crates//:tikv-jemallocator"],
)
