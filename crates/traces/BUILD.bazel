load("//:bazel/rust_package.bzl", "rust_feature_binary", "rust_package")

rust_package(
    name = "traces",
    build_script = True,
    cargo_name = "crabka-traces",
    crate_name = "crabka_traces",
    harnessless = ["traceql_conformance"],
    test_compile_data = ["//crates/traceql:conformance_data"],
)

rust_feature_binary(
    name = "crabka-traces-heap__bin",
    crate_label = ":traces",
    crate_root = "src/bin/crabka-traces.rs",
    features = ["heap-profiling"],
    deps = ["@crates//:tikv-jemallocator"],
)
