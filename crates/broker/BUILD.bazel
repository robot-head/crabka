load("//:bazel/rust_package.bzl", "rust_feature_binary", "rust_package")

filegroup(
    name = "test_support",
    srcs = glob(["tests/support/**"]),
    visibility = ["//visibility:public"],
)

rust_package(
    name = "broker",
    cargo_name = "crabka-broker",
    crate_name = "crabka_broker",
    test_binaries = {"crabka": "//crates/cli:crabka__bin"},
    test_compile_data = ["//crates/security:test_fixtures"],
    test_sizes = {
        "jvm_acceptance": "large",
        "jvm_consumer_group_next_gen": "medium",
        "metrics": "small",
        "produce_verbatim_passthrough": "small",
    },
)

rust_feature_binary(
    name = "crabka-broker-heap__bin",
    crate_label = ":broker",
    crate_root = "src/bin/broker.rs",
    features = ["heap-profiling"],
    deps = ["@crates//:tikv-jemallocator"],
)
