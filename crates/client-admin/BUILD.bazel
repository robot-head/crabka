load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//:bazel/rust_package.bzl", "cargo_features", "normal_aliases", "rust_package_tests")

# Manifest is consumed by crate_universe (see //MODULE.bazel).
exports_files(["Cargo.toml"])

rust_library(
    name = "client-admin",
    srcs = glob(["src/**/*.rs"]),
    aliases = normal_aliases(),
    crate_features = cargo_features(),
    crate_name = "crabka_client_admin",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_package_tests(
    name = "client-admin",
    crate_label = ":client-admin",
    test_sizes = {
        "delete_records": "small",
        "groups": "small",
        "reconnect": "small",
    },
)
