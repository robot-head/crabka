load("//:bazel/rust_package.bzl", "rust_feature_binary", "rust_package")

rust_package(
    name = "metrics-service",
    cargo_name = "crabka-metrics-service",
    crate_name = "crabka_metrics_service",
    test_compile_data = ["//crates/metrics:test_support"],
    test_tags = {
        "diff_prometheus": ["manual"],
        "diff_mimir": ["manual"],
        "grafana_integration": ["manual"],
    },
)

rust_feature_binary(
    name = "crabka-metrics-service-heap__bin",
    crate_label = ":metrics-service",
    crate_root = "src/main.rs",
    features = ["heap-profiling"],
    deps = ["@crates//:tikv-jemallocator"],
)
