load("//:bazel/rust_package.bzl", "rust_package")

filegroup(
    name = "test_data",
    srcs = glob(["tests/snapshots/**/*.rs"]),
)

rust_package(
    name = "protocol-codegen",
    cargo_name = "crabka-protocol-codegen",
    crate_name = "crabka_protocol_codegen",
    lib_test_size = "small",
    test_compile_data = [
        ":test_data",
        "//crates/protocol:schemas",
        "//:rustfmt",
    ],
    test_env = {"RUSTFMT": "$(rootpath //:rustfmt)"},
    test_size = "small",
)
