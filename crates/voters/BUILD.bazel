load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//:bazel/rust_package.bzl", "cargo_features", "normal_aliases")

# Manifest is consumed by crate_universe (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# Pure value-type leaf crate (pulled in transitively by //crates/metadata).
rust_library(
    name = "voters",
    srcs = glob(["src/**/*.rs"]),
    aliases = normal_aliases(),
    crate_features = cargo_features(),
    crate_name = "crabka_voters",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
