load("//:bazel/rust_package.bzl", "rust_feature_binary", "rust_package")

rust_package(
    name = "schema-registry",
    cargo_name = "crabka-schema-registry",
    crate_name = "crabka_schema_registry",
    harnessless = ["compat_conformance"],
    lib_test_size = "small",
    test_sizes = {
        "compat_conformance": "small",
        "ha": "small",
        "integration": "small",
        "rest_conformance": "small",
        "schemas_record": "small",
        "security": "small",
    },
)

rust_feature_binary(
    name = "crabka-schema-registry-heap__bin",
    crate_label = ":schema-registry",
    crate_root = "src/bin/schema-registry.rs",
    features = ["heap-profiling"],
    deps = ["@crates//:tikv-jemallocator"],
)
