"""Crabka's non-Bazel orchestration tasks."""

def _run(ctx, executable, argv = [], current_dir = ""):
    command = ctx.std.process.command(executable).args(argv)
    if current_dir:
        command = command.current_dir(current_dir)
    return command.spawn().wait().code

def _output(ctx, executable, argv = [], current_dir = ""):
    command = ctx.std.process.command(executable).args(argv)
    if current_dir:
        command = command.current_dir(current_dir)
    result = command.stdout("piped").spawn().wait_with_output()
    return (result.status.code, result.stdout.strip())

def _targets(ctx, path):
    return [target for target in ctx.std.fs.read_to_string(path).split("\n") if target]

def _matches_prefix(targets, prefixes):
    return any([target.startswith(prefix) for target in targets for prefix in prefixes])

def _matches_exact(targets, labels):
    return any([label in targets for label in labels])

_AFFECTED_GLOBAL_INPUTS = [
    ".aspect/config.axl",
    ".aspect/tasks.axl",
    ".aspect/version.axl",
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".github/actions/setup-bazel/action.yml",
    ".github/workflows/ci.yml",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "Cargo.toml",
    "Cargo.lock",
    "bazel/patches/rules_rs-build-script-warnings.patch",
    "rust-toolchain.toml",
]

_BAZEL_DIFF_SHA256 = "69ab1fd00f0ba0f15bb36ded659a58040b41957f712461aa46d98b7e58869aa3"
_BAZEL_DIFF_URL = "https://github.com/Tinder/bazel-diff/releases/download/v27.0.0/bazel-diff_deploy.jar"
_DISK_CACHE_MARKER = ".crabka-snapshot-v1"

_PR_MANUAL_TESTS = [
    "//crates/broker:jvm_acceptance",
    "//crates/broker:jvm_consumer_group_next_gen",
    "//crates/compression:differential",
    "//crates/grpc-gateway:jvm_differential",
    "//crates/integration-tests:diskless_jepsen",
    "//crates/metrics-service:diff_prometheus",
    "//crates/protocol:differential_all",
    "//crates/protocol:differential_api_versions",
    "//crates/protocol:differential_describe_groups",
    "//crates/protocol:differential_metadata",
    "//crates/protocol:differential_offset_commit",
    "//crates/protocol:differential_produce",
    "//crates/protocol:differential_records",
    "//scripts:gres_kind_lifecycle_test",
    "//verif:creusot_replay",
]

_DOC_EXAMPLES = [
    "avro_pipeline",
    "dataframe_serde",
    "format_arrow",
    "format_dsl",
    "format_json",
    "format_pipeline",
    "json_pipeline",
    "polars_pipeline",
    "profile_streams",
    "protobuf_pipeline",
]
_DOC_EXAMPLE_TARGETS = ["//crates/client-streams:example_" + example for example in _DOC_EXAMPLES]
_DOCGEN_TARGET = "//crates/docgen:crabka-docgen__bin"
_DOCS_PLAYGROUND_TARGET = "//crates/playground:playground_web"

def _direct_dependencies(ctx, targets):
    if not targets:
        return (0, [])
    target_set = "set(%s)" % " ".join(targets)
    direct_deps = "deps(%s, 1)" % target_set
    (code, output) = _output(ctx, "bazel", [
        "query",
        "--noimplicit_deps",
        "kind('rule|generated file', %s except %s) except kind('.*_test rule|test_suite rule', %s)" % (direct_deps, target_set, direct_deps),
    ])
    return (code, [target for target in output.split("\n") if target])

def _affected_suites(impacted, tests):
    creusot = _matches_exact(impacted, ["//verif:creusot_replay"])
    grpc_gateway_jvm = _matches_exact(impacted, ["//crates/grpc-gateway:jvm_differential"])
    gres = _matches_prefix(tests, [
        "//crates/cli:",
        "//crates/gres-activator:",
        "//crates/gres-balancer:",
        "//crates/gres-conformance:",
        "//crates/gres-control:",
        "//crates/gres-fdw:",
        "//crates/gres-ranges:",
        "//crates/gres-substrate:",
        "//crates/gres:",
        "//crates/pgexec:",
        "//crates/pgwire:",
    ]) or _matches_exact(impacted, [
        "//scripts:gres_kind_lifecycle_structure_test",
        "//scripts:gres_kind_lifecycle_test",
        "//scripts:gres_range_scaling_contract_test",
    ])
    jvm_oracle = _matches_exact(impacted, [
        "//crates/compression:differential",
        "//crates/protocol:differential_all",
        "//crates/protocol:differential_api_versions",
        "//crates/protocol:differential_describe_groups",
        "//crates/protocol:differential_metadata",
        "//crates/protocol:differential_offset_commit",
        "//crates/protocol:differential_produce",
        "//crates/protocol:differential_records",
    ])
    return [
        ("admin_ui", _matches_prefix(tests, ["//crates/admin-ui:"])),
        ("broker_integration", _matches_prefix(tests, ["//crates/broker:", "//crates/client-admin:"]) or _matches_exact(impacted, ["//crates/integration-tests:diskless_jepsen"])),
        ("broker_jvm", _matches_exact(impacted, ["//crates/broker:jvm_acceptance", "//crates/broker:jvm_consumer_group_next_gen"])),
        ("client_consumer", _matches_prefix(tests, ["//crates/client-consumer:"])),
        ("client_core", _matches_exact(tests, ["//crates/client-core:integration"])),
        ("client_streams", _matches_prefix(tests, ["//crates/client-streams:"]) or _matches_exact(tests, ["//crates/schema-serde:schema-serde_lib_test"])),
        ("creusot", creusot),
        ("gres", gres),
        ("grpc_gateway", _matches_prefix(tests, ["//crates/grpc-gateway:"])),
        ("grpc_gateway_jvm", grpc_gateway_jvm),
        ("jvm_differential", grpc_gateway_jvm or jvm_oracle),
        ("jvm_oracle", jvm_oracle),
        ("log", _matches_exact(tests, ["//crates/log:integration"])),
        ("metrics_conformance", _matches_exact(tests, ["//crates/promql:conformance"])),
        ("metrics_differential", _matches_exact(impacted, ["//crates/metrics-service:diff_prometheus"])),
        ("operator", _matches_prefix(tests, ["//crates/operator:"])),
        ("schema_registry", _matches_exact(tests, [
            "//crates/schema-registry:compat_conformance",
            "//crates/schema-registry:ha",
            "//crates/schema-registry:integration",
            "//crates/schema-registry:rest_conformance",
            "//crates/schema-registry:schemas_record",
            "//crates/schema-registry:security",
        ])),
        ("traces", _matches_prefix(tests, ["//crates/traceql:", "//crates/traces:"])),
    ]

def _write_affected_plan(ctx, plan_dir, builds, tests, warm_tests, suites):
    ctx.std.fs.create_dir_all(plan_dir)
    ctx.std.fs.write(plan_dir + "/builds.txt", "\n".join(builds) + ("\n" if builds else ""))
    ctx.std.fs.write(plan_dir + "/tests.txt", "\n".join(tests) + ("\n" if tests else ""))
    ctx.std.fs.write(plan_dir + "/warm-tests.txt", "\n".join(warm_tests) + ("\n" if warm_tests else ""))
    ctx.std.fs.write(plan_dir + "/suites.txt", "\n".join([
        "%s=%s" % (name, "true" if affected else "false")
        for name, affected in suites
    ]) + "\n")

def _bazel_diff(ctx):
    # Building the planner through the main module graph adds a cold Kotlin /
    # protobuf build before Bazel can even inspect the repository. Use the
    # official release artifact instead, pinned and verified like a toolchain.
    cache_dir = ctx.std.env.current_dir() + "/.aspect/cache"
    ctx.std.fs.create_dir_all(cache_dir)
    jar = cache_dir + "/bazel-diff-v27.0.0.jar"
    if _run(ctx, "test", ["-f", jar]) == 0:
        (code, digest) = _output(ctx, "sha256sum", [jar])
        if code == 0 and digest.split(" ")[0] == _BAZEL_DIFF_SHA256:
            return (0, jar)

    download = jar + ".download"
    code = _run(ctx, "rm", ["-f", "--", jar, download])
    if code == 0:
        code = _run(ctx, "curl", [
            "--fail",
            "--location",
            "--retry",
            "3",
            "--show-error",
            "--silent",
            "--output",
            download,
            _BAZEL_DIFF_URL,
        ])
    if code == 0:
        (code, digest) = _output(ctx, "sha256sum", [download])
    if code != 0 or digest.split(" ")[0] != _BAZEL_DIFF_SHA256:
        _run(ctx, "rm", ["-f", "--", download])
        print("bazel-diff v27.0.0 failed SHA-256 verification")
        return (1, "")
    code = _run(ctx, "mv", ["--", download, jar])
    return (code, jar if code == 0 else "")

def _bazel_diff_jvm_flags(ctx):
    # JDK 24+ warns when bazel-diff's protobuf runtime uses sun.misc.Unsafe;
    # older hosted-runner JDKs reject the flag that silences it.
    (code, version) = _output(ctx, "java", ["--version"])
    if code != 0:
        return []
    fields = version.split("\n")[0].split(" ")
    if len(fields) < 2:
        return []
    major = int(fields[1].split(".")[0])
    return ["--sun-misc-unsafe-memory-access=allow"] if major >= 24 else []

def _generate_hashes(ctx, bazel_diff, workspace, hash_file):
    (code, temp) = _output(ctx, "mktemp", ["-d", ctx.std.env.temp_dir() + "/crabka-affected.XXXXXX"])
    if code != 0:
        return code
    (code, workspace) = _output(ctx, "realpath", [workspace])
    if code != 0:
        _run(ctx, "rm", ["-rf", "--", temp])
        return code
    # bazel-diff accepts a set of seed paths, whose iteration order is not
    # stable across the base and head workspace prefixes. Feed it one
    # deterministic payload instead.
    seed_content = ""
    for path in _AFFECTED_GLOBAL_INPUTS:
        filepath = workspace + "/" + path
        seed_content += "== " + path + " ==\n"
        if _run(ctx, "test", ["-f", filepath]) == 0:
            seed_content += ctx.std.fs.read_to_string(filepath)
        else:
            seed_content += "<missing>"
        seed_content += "\n"
    seed_payload = temp + "/global-seed.txt"
    ctx.std.fs.write(seed_payload, seed_content)
    seed_file = temp + "/seed-filepaths.txt"
    ctx.std.fs.write(seed_file, seed_payload + "\n")
    (code, repository_cache) = _output(ctx, "bazel", ["info", "repository_cache"], workspace)
    if code == 0:
        code = _run(ctx, "java", _bazel_diff_jvm_flags(ctx) + [
            "-jar",
            bazel_diff,
            "generate-hashes",
            "--no-keep_going",
            "--excludeExternalTargets",
            "--includeTargetType",
            "--bazelCommandOptions=--repository_cache=" + repository_cache,
            "--seed-filepaths=" + seed_file,
            "-w",
            workspace,
            hash_file,
        ])
    cleanup = _run(ctx, "rm", ["-rf", "--", temp])
    shutdown = 0
    if workspace != ctx.std.env.current_dir():
        # The next hash uses the head workspace. Stop this server explicitly so
        # Bazel does not warn and restart it when the workspace path changes.
        shutdown = _run(ctx, "bazel", ["shutdown"], workspace)
    if code != 0:
        return code
    return cleanup if cleanup != 0 else shutdown

def _affected(ctx: TaskContext) -> int:
    plan_dir = ctx.args.plan_dir
    if ctx.args.mode not in ["hash", "plan", "warm", "test"]:
        print("mode must be hash, plan, warm, or test")
        return 2
    if ctx.args.mode == "hash" and not ctx.args.hash_file:
        print("--hash-file is required in hash mode")
        return 2
    if ctx.args.mode == "plan" and (not ctx.args.starting_hashes or not ctx.args.final_hashes):
        print("--starting-hashes and --final-hashes are required in plan mode")
        return 2
    if ctx.args.shards < 1 or ctx.args.shard < 0 or ctx.args.shard >= ctx.args.shards:
        print("shard must be between zero and shards minus one")
        return 2
    if ctx.args.mode == "warm":
        targets = _targets(ctx, plan_dir + "/builds.txt")
        # Include suite-owned and manual tests here even though dedicated jobs
        # run them. Building only their direct dependencies populates one cache
        # snapshot without executing or compiling the test binaries themselves.
        roots = _targets(ctx, plan_dir + "/warm-tests.txt")
        (code, dependencies) = _direct_dependencies(ctx, roots)
        if code != 0:
            return code
        targets.extend(dependencies)
        if targets:
            code = _run(ctx, "bazel", [
                "build",
                "--config=ci",
                "--instrument_test_targets",
                "--strip=never",
                "--nobuild_tests_only",
            ] + targets)
            if code != 0:
                return code

        # Docs use the normal target configuration, so keep their cache keys
        # separate from the instrumented test dependencies above.
        doc_roots = []
        if ctx.args.doc_examples:
            doc_roots.extend(_DOC_EXAMPLE_TARGETS + [_DOCGEN_TARGET])
        if ctx.args.docs:
            (code, docs_output) = _output(ctx, "bazel", ["query", "kind(rust_doc, //...)"])
            if code != 0:
                return code
            doc_roots.extend([_DOCGEN_TARGET] + [target for target in docs_output.split("\n") if target])
        (code, doc_dependencies) = _direct_dependencies(ctx, doc_roots)
        if code != 0:
            return code
        if doc_dependencies:
            code = _run(ctx, "bazel", ["build", "--config=ci"] + doc_dependencies)
            if code != 0:
                return code
        if ctx.args.docs:
            (code, playground_dependencies) = _direct_dependencies(ctx, [_DOCS_PLAYGROUND_TARGET])
            if code != 0:
                return code
            if playground_dependencies:
                return _run(ctx, "bazel", [
                    "build",
                    "--config=ci",
                    "--platforms=//platforms:wasm",
                ] + playground_dependencies)
        return 0
    if ctx.args.mode == "test":
        tests = _targets(ctx, plan_dir + "/tests.txt")
        tests = [target for index, target in enumerate(tests) if index % ctx.args.shards == ctx.args.shard]
        if not tests:
            return 0
        return _run(ctx, "aspect", ["test"] + tests + [
            "--bazel-flag=--config=ci",
            "--bazel-flag=--nobuild_tests_only",
            # Loki finishes in Bazel's medium timing band locally but can take
            # over five minutes on a contended four-core hosted runner.
            "--bazel-flag=--test_timeout=60,900,900,3600",
            "--bazel-flag=--test_verbose_timeout_warnings",
        ])

    (code, bazel_diff) = _bazel_diff(ctx)
    if code != 0:
        return code
    if ctx.args.mode == "hash":
        return _generate_hashes(ctx, bazel_diff, ctx.args.workspace, ctx.args.hash_file)

    (code, impacted_path) = _output(ctx, "mktemp", [ctx.std.env.temp_dir() + "/crabka-impacted.XXXXXX"])
    if code != 0:
        return code
    code = _run(ctx, "java", _bazel_diff_jvm_flags(ctx) + [
        "-jar",
        bazel_diff,
        "get-impacted-targets",
        "-w",
        ctx.std.env.current_dir(),
        "-sh",
        ctx.args.starting_hashes,
        "-fh",
        ctx.args.final_hashes,
        "-tt",
        "Rule",
        "-o",
        impacted_path,
    ])
    if code != 0:
        _run(ctx, "rm", ["-f", "--", impacted_path])
        return code
    impacted = [target for target in ctx.std.fs.read_to_string(impacted_path).split("\n") if target]
    cleanup = _run(ctx, "rm", ["-f", "--", impacted_path])
    if cleanup != 0:
        return cleanup
    if not impacted:
        if ctx.args.mode == "plan":
            _write_affected_plan(ctx, plan_dir, [], [], [], _affected_suites([], []))
        print("No Bazel targets are affected.")
        return 0

    target_set = "set(%s)" % " ".join(impacted)
    pr_manual_tests = "set(%s)" % " ".join(_PR_MANUAL_TESTS)
    warm_query = "(kind('.*_test rule', %s) except attr(tags, 'manual', %s)) + (%s intersect %s)" % (target_set, target_set, pr_manual_tests, target_set)
    (code, warm_tests_output) = _output(ctx, "bazel", ["query", warm_query])
    if code != 0:
        return code
    (code, tests_output) = _output(ctx, "bazel", ["query", "kind('(rust_test|rust_compile_fail_test) rule', %s) except attr(tags, 'manual', %s)" % (target_set, target_set)])
    if code != 0:
        return code
    # Images, packaging, docs, and environment-heavy tests have dedicated CI
    # jobs below this graph gate. Compile only affected host code here so those
    # jobs do not duplicate APKO/OCI cross-platform builds.
    host_code = "kind('(rust_(binary|library|proc_macro|shared_library)|java_binary)', %s)" % target_set
    (code, builds_output) = _output(ctx, "bazel", ["query", "%s except attr(target_compatible_with, '.*wasm32.*', %s)" % (host_code, host_code)])
    if code != 0:
        return code

    dedicated_build_prefixes = [
        "//crates/admin-ui:",
        "//crates/broker:",
        "//crates/cli:",
        "//crates/client-admin:",
        "//crates/client-consumer:",
        "//crates/client-core:",
        "//crates/client-streams:",
        "//crates/gres-activator:",
        "//crates/gres-balancer:",
        "//crates/gres-conformance:",
        "//crates/gres-control:",
        "//crates/gres-fdw:",
        "//crates/gres-ranges:",
        "//crates/gres-substrate:",
        "//crates/gres:",
        "//crates/grpc-gateway:",
        "//crates/log:",
        "//crates/pgexec:",
        "//crates/pgwire:",
        "//crates/operator:",
        "//crates/promql:",
        "//crates/schema-registry:",
        "//crates/schema-serde:",
        "//crates/traceql:",
        "//crates/traces:",
    ]
    builds = [target for target in builds_output.split("\n") if target and not any([
        target.startswith(prefix) for prefix in dedicated_build_prefixes
    ]) and ":bench_" not in target and not target.endswith("-heap__bin")]
    all_tests = [target for target in tests_output.split("\n") if target]
    suites = _affected_suites(impacted, all_tests)
    owned_test_prefixes = [
        "//crates/admin-ui:",
        "//crates/broker:",
        "//crates/cli:",
        "//crates/client-admin:",
        "//crates/client-consumer:",
        "//crates/client-streams:",
        "//crates/gres-activator:",
        "//crates/gres-balancer:",
        "//crates/gres-conformance:",
        "//crates/gres-control:",
        "//crates/gres-fdw:",
        "//crates/gres-ranges:",
        "//crates/gres-substrate:",
        "//crates/gres:",
        "//crates/grpc-gateway:",
        "//crates/operator:",
        "//crates/pgexec:",
        "//crates/pgwire:",
        "//crates/schema-serde:",
        "//crates/traceql:",
        "//crates/traces:",
    ]
    owned_tests = [
        "//crates/client-core:integration",
        "//crates/log:integration",
        "//crates/promql:conformance",
        "//crates/schema-registry:compat_conformance",
        "//crates/schema-registry:ha",
        "//crates/schema-registry:integration",
        "//crates/schema-registry:rest_conformance",
        "//crates/schema-registry:schemas_record",
        "//crates/schema-registry:security",
    ]
    tests = [target for target in all_tests if target not in owned_tests and not any([
        target.startswith(prefix) for prefix in owned_test_prefixes
    ])]
    # The warmer submits build roots and test dependencies in one Bazel
    # invocation, so Bazel deduplicates any overlap without another full graph
    # traversal here.
    warm_tests = [target for target in warm_tests_output.split("\n") if target]
    _write_affected_plan(ctx, plan_dir, builds, tests, warm_tests, suites)
    print("Planned %d builds, %d tests, and %d dependency roots." % (len(builds), len(tests), len(warm_tests)))
    return 0

affected = task(
    implementation = _affected,
    summary = "Hash, plan, build, or test affected Bazel targets.",
    args = {
        "doc_examples": args.boolean(default = False, description = "Warm direct dependencies of documentation examples."),
        "docs": args.boolean(default = False, description = "Warm direct dependencies of the full documentation build."),
        "final_hashes": args.string(default = "", description = "Final bazel-diff hashes."),
        "hash_file": args.string(default = "", description = "Hash output path."),
        "mode": args.string(default = "plan", description = "Hash, plan, warm, or test affected targets."),
        "plan_dir": args.string(default = ".aspect/affected-plan", description = "Affected plan directory."),
        "shard": args.int(default = 0, description = "Zero-based test shard."),
        "shards": args.int(default = 1, description = "Number of test shards."),
        "starting_hashes": args.string(default = "", description = "Starting bazel-diff hashes."),
        "workspace": args.string(default = ".", description = "Workspace to hash."),
    },
)

def _prune_disk_cache(ctx, cache_dir, max_size):
    entries = []
    total_size = 0
    for kind in ["ac", "cas"]:
        directory = cache_dir + "/" + kind
        if _run(ctx, "test", ["-d", directory]) != 0:
            continue
        (code, output) = _output(ctx, "find", [
            directory,
            "-type", "f",
            "-printf", "%T@|%s|%p\n",
        ])
        if code != 0:
            return code
        for line in output.split("\n"):
            if not line:
                continue
            fields = line.split("|")
            if len(fields) != 3:
                print("Unexpected disk-cache entry from find: %s" % line)
                return 1
            size = int(fields[1])
            entries.append((fields[0], fields[2], size))
            total_size += size

    if total_size <= max_size:
        return 0

    remaining_size = total_size
    delete_paths = []
    for (_, path, size) in sorted(entries):
        if remaining_size <= max_size:
            break
        delete_paths.append(path)
        remaining_size -= size
    for offset in range(0, len(delete_paths), 1000):
        code = _run(ctx, "rm", ["-f", "--"] + delete_paths[offset:offset + 1000])
        if code != 0:
            return code
    print("Pruned Bazel disk cache from %d to %d bytes." % (total_size, remaining_size))
    return 0

def _affected_cache(ctx: TaskContext) -> int:
    if ctx.args.mode not in ["pack", "restore"]:
        print("mode must be pack or restore")
        return 2
    if not ctx.args.archive or not ctx.args.cache_dir:
        print("--archive and --cache-dir are required")
        return 2

    marker = ctx.args.cache_dir + "/" + _DISK_CACHE_MARKER
    if ctx.args.mode == "pack":
        if not ctx.args.snapshot:
            print("--snapshot is required in pack mode")
            return 2
        if _run(ctx, "test", ["-d", ctx.args.cache_dir]) != 0:
            print("Bazel disk cache not found at %s" % ctx.args.cache_dir)
            return 1
        code = _prune_disk_cache(ctx, ctx.args.cache_dir, ctx.args.max_size_mib * 1048576)
        if code != 0:
            return code
        had_marker = _run(ctx, "test", ["-f", marker]) == 0
        previous_marker = ctx.std.fs.read_to_string(marker) if had_marker else ""
        ctx.std.fs.write(marker, ctx.args.snapshot + "\n")
        code = _run(ctx, "tar", [
            "--create",
            "--file", ctx.args.archive,
            "--use-compress-program=zstd -3 -T0",
            "--directory", ctx.args.cache_dir,
            ".",
        ])
        if code != 0:
            if had_marker:
                ctx.std.fs.write(marker, previous_marker)
            else:
                _run(ctx, "rm", ["-f", "--", marker])
        return code

    ctx.std.fs.create_dir_all(ctx.args.cache_dir)
    code = _run(ctx, "tar", [
        "--extract",
        "--file", ctx.args.archive,
        "--use-compress-program=zstd -1 -T0",
        "--no-same-owner",
        "--directory", ctx.args.cache_dir,
    ])
    if code == 0 and _run(ctx, "test", ["-f", marker]) != 0:
        print("Restored Bazel disk cache has no completion marker")
        code = 1
    cleanup = _run(ctx, "rm", ["-f", "--", ctx.args.archive])
    return code if code != 0 else cleanup

affected_cache = task(
    implementation = _affected_cache,
    summary = "Pack or restore a completed affected Bazel disk cache.",
    args = {
        "archive": args.string(default = "", description = "Compressed cache archive."),
        "cache_dir": args.string(default = "", description = "Bazel disk-cache directory."),
        "max_size_mib": args.int(default = 10240, description = "Maximum unpacked cache size in MiB."),
        "mode": args.string(default = "", description = "Pack or restore the disk cache."),
        "snapshot": args.string(default = "", description = "Completed run and attempt identifier."),
    },
)

def _coverage_report(ctx: TaskContext) -> int:
    (code, output_path) = _output(ctx, "bazel", ["info", "output_path", "--config=ci"])
    if code != 0:
        return code
    (code, output_dir) = _output(ctx, "dirname", [ctx.args.output])
    if code != 0:
        return code
    ctx.std.fs.create_dir_all(output_dir)
    source = output_path + "/_coverage/_coverage_report.dat"
    code = _run(ctx, "cp", ["--", source, ctx.args.output])
    if code == 0:
        print("Copied Bazel LCOV report to %s" % ctx.args.output)
    return code

coverage_report = task(
    implementation = _coverage_report,
    summary = "Copy Bazel's combined LCOV report to a stable path.",
    args = {
        "output": args.string(default = "lcov.info", description = "Destination LCOV path."),
    },
)

def _codegen(ctx: TaskContext) -> int:
    code = _run(ctx, "bazel", [
        "build",
        "//crates/operator:crabka-operator__bin",
        "//crates/protocol-codegen:crabka-protocol-codegen__bin",
        "//:rustfmt",
    ])
    if code != 0:
        return code
    for executable in ["tools/regenerate.sh", "tools/regen-crds.sh"]:
        code = _run(ctx, executable)
        if code != 0:
            return code
    return 0 if ctx.args.fix else _run(ctx, "git", ["diff", "--exit-code"])

codegen = task(
    implementation = _codegen,
    summary = "Regenerate checked-in sources and verify a clean diff.",
    args = {
        "fix": args.boolean(default = False, description = "Keep regenerated source changes."),
    },
)

def _docs(ctx: TaskContext) -> int:
    code = _run(ctx, "bazel", ["build", "--config=ci"] + _DOC_EXAMPLE_TARGETS)
    if code != 0:
        return code
    for example in ["format_json", "format_arrow", "format_dsl", "format_pipeline"]:
        code = _run(ctx, "bazel-bin/crates/client-streams/example_" + example)
        if code != 0:
            return code
    code = _run(ctx, "bazel", ["run", "//crates/docgen:crabka-docgen__bin", "--config=ci", "--", "snippets"])
    if code != 0:
        return code
    return _run(ctx, "git", ["diff", "--exit-code", "--", "website/content"])

docs = task(
    implementation = _docs,
    summary = "Build and test documentation examples.",
    args = {},
)

def _playground(ctx: TaskContext) -> int:
    code = _run(ctx, "bazel", ["build", "//crates/playground:playground_web", "--platforms=//platforms:wasm", "--config=ci"])
    if code != 0:
        return code
    code = _run(ctx, "mkdir", ["-p", "website/static/playground"])
    if code != 0:
        return code
    for filename in ["crabka_playground.js", "crabka_playground_bg.wasm"]:
        code = _run(ctx, "cp", ["bazel-bin/crates/playground/playground_web/" + filename, "website/static/playground/" + filename])
        if code != 0:
            return code
    return 0

playground = task(
    implementation = _playground,
    summary = "Build and stage the hermetic WASM playground.",
    args = {},
)

def _publish_check(ctx: TaskContext) -> int:
    code = _run(ctx, "tools/check-publish-allowlist.sh")
    return code if code != 0 else _run(ctx, "tools/publish-dryrun.sh")

publish_check = task(
    implementation = _publish_check,
    summary = "Validate the crates.io package set and dry-run publication.",
    args = {},
)

_GRES_SUITES = {
    "adopt-regress": "tools/gres-adopt-regress.sh",
    "check-pg-compat": "tools/check-pg-compat-matrix.sh",
    "coldstart": "scripts/gres-coldstart.sh",
    "driver-goldens": "scripts/gres-driver-goldens-gate.sh",
    "durable-restart": "scripts/gres-durable-restart-smoke.sh",
    "e2e": "scripts/gres-e2e.sh",
    "kind-lifecycle": "scripts/gres-kind-lifecycle.sh",
    "psql": "scripts/gres-psql-smoke.sh",
    "psql-introspection": "scripts/gres-psql-introspection-smoke.sh",
    "range-scaling": "scripts/gres-range-scaling.sh",
    "range-scaling-ci": "scripts/tests/gres-range-scaling-ci.sh",
    "sharded-conformance": "scripts/gres-sharded-conformance.sh",
    "substrate": "scripts/gres-substrate-smoke.sh",
    "topology-process-nemesis": "scripts/tests/gres-topology-process-nemesis-ci.sh",
}

def _gres(ctx: TaskContext) -> int:
    bazel_tests = {
        "coldstart": [
            "//scripts:gres_kind_lifecycle_structure_test",
            "//scripts:gres_kind_lifecycle_test",
        ],
        "range-scaling-ci": ["//scripts:gres_range_scaling_contract_test"],
    }
    if ctx.args.suite in bazel_tests:
        code = _run(ctx, "bazel", [
            "test",
            "--config=ci",
        ] + bazel_tests[ctx.args.suite])
        if ctx.args.suite != "coldstart":
            return code
        (info_code, testlogs) = _output(ctx, "bazel", ["info", "bazel-testlogs", "--config=ci"])
        if info_code != 0:
            return code if code != 0 else info_code
        source = testlogs + "/scripts/gres_kind_lifecycle_test/test.outputs"
        destination = "target/gres-coldstart-artifacts"
        if _run(ctx, "test", ["-d", source]) != 0:
            print("Gres cold-start test outputs not found at %s" % source)
            return code if code != 0 else 1
        copy_code = _run(ctx, "rm", ["-rf", "--", destination])
        if copy_code == 0:
            ctx.std.fs.create_dir_all(destination)
            copy_code = _run(ctx, "cp", ["-R", "--", source + "/.", destination])
        return code if code != 0 else copy_code
    executable = _GRES_SUITES.get(ctx.args.suite)
    if executable == None:
        print("unknown suite %r; choose one of: %s" % (ctx.args.suite, ", ".join(sorted(_GRES_SUITES.keys()))))
        return 2
    binaries = {
        "crabka": "bazel-bin/crates/cli/crabka__bin",
        "crabka-broker": "bazel-bin/crates/broker/crabka-broker__bin",
        "crabka-gres": "bazel-bin/crates/gres/crabka-gres__bin",
        "crabka-gres-activator": "bazel-bin/crates/gres-activator/crabka-gres-activator__bin",
        "crabka-gres-conformance": "bazel-bin/crates/gres-conformance/crabka-gres-conformance__bin",
        "crabka-gres-driver-golden-replay": "bazel-bin/crates/gres-conformance/crabka-gres-driver-golden-replay__bin",
        "crabka-gres-driver-smoke": "bazel-bin/crates/gres-conformance/crabka-gres-driver-smoke__bin",
    }
    build_targets = [
        "//crates/cli:crabka__bin",
        "//crates/broker:crabka-broker__bin",
        "//crates/gres:crabka-gres__bin",
        "//crates/gres-activator:crabka-gres-activator__bin",
        "//crates/gres-conformance:crabka-gres-conformance__bin",
        "//crates/gres-conformance:crabka-gres-driver-golden-replay__bin",
        "//crates/gres-conformance:crabka-gres-driver-smoke__bin",
    ]
    required_binaries = binaries.keys()
    if ctx.args.suite == "topology-process-nemesis":
        build_targets = ["//crates/cli:crabka__bin"]
        required_binaries = ["crabka"]
    if _run(ctx, "test", ["-x", "target/debug/crabka-gres-driver-smoke"]) != 0:
        code = _run(ctx, "bazel", [
            "build",
            "--config=ci",
            "--instrument_test_targets",
            "--strip=never",
        ] + build_targets)
        if code != 0:
            return code
        code = _run(ctx, "mkdir", ["-p", "target/debug"])
        if code != 0:
            return code
        for name in required_binaries:
            source = binaries[name]
            code = _run(ctx, "cp", [source, "target/debug/" + name])
            if code != 0:
                return code
    return _run(ctx, "env", ["CRABKA_GRES_SKIP_BUILD=1", executable] + ctx.args.args)

gres = task(
    implementation = _gres,
    summary = "Run a GRES integration suite.",
    args = {
        "suite": args.string(required = True, description = "GRES suite name."),
        "args": args.trailing_var_args(description = "Arguments forwarded to the suite."),
    },
)

def _benchmark(ctx: TaskContext) -> int:
    argv = [ctx.args.stack, ctx.args.scenario, ctx.args.topology] + (["true"] if ctx.args.tls else [])
    code = _run(ctx, "bench/scripts/run-scenario.sh", argv)
    cleanup = _run(ctx, "bench/scripts/teardown.sh", [ctx.args.stack])
    return code if code != 0 else cleanup

benchmark = task(
    implementation = _benchmark,
    summary = "Run a benchmark scenario.",
    args = {
        "stack": args.string(required = True),
        "scenario": args.string(required = True),
        "topology": args.string(required = True),
        "tls": args.boolean(default = False),
    },
)

def _publish_creusot_image(ctx: TaskContext) -> int:
    return _run(ctx, "tools/build-creusot-image.sh", [ctx.args.image])

publish_creusot_image = task(
    implementation = _publish_creusot_image,
    summary = "Build and push the Creusot CI image.",
    args = {
        "image": args.string(required = True),
    },
)
