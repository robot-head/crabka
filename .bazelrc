# Crabka Bazel configuration.
#
# Bazel is a *secondary*, client-focused build path: it produces the lean Kafka
# client libraries (producer/consumer/admin/core + serdes) for embedders who
# want a slim dependency closure. Cargo remains the source of truth for the
# full workspace; Bazel reads the same Cargo.toml / Cargo.lock via crate_universe.

# bzlmod is the only dependency-resolution path (no legacy WORKSPACE).
common --enable_bzlmod

# Keep the action environment hermetic so build-script outputs are reproducible.
build --incompatible_strict_action_env

test --test_output=errors

# Optional developer-local overrides (registry mirrors, remote cache, etc.).
try-import %workspace%/user.bazelrc
