# Crabka Bazel configuration. Bazel is the build and test source of truth;
# Cargo.toml and Cargo.lock remain the crates.io metadata and dependency lock.

# bzlmod is the only dependency-resolution path (no legacy WORKSPACE).
common --enable_bzlmod
common --enable_platform_specific_config
common:windows --host_platform=//platforms:local_windows_msvc

# The hermetic LLVM toolchain intentionally supplies --unwindlib=none. Clang
# reports that toolchain-owned argument through rustc's linker_messages lint;
# silence it for both host tools and target binaries without changing the link.
build:linux --@rules_rust//rust/settings:extra_exec_rustc_flag=-Alinker-messages
build:linux --@rules_rust//rust/settings:extra_rustc_flag=-Alinker-messages

# Keep the action environment hermetic so build-script outputs are reproducible.
build --incompatible_strict_action_env

test --test_output=errors
test --instrument_test_targets

build:ci --announce_rc
build:ci --color=yes
build:ci --curses=no
build:ci --show_timestamps
build:ci --compilation_mode=opt
build:ci --strip=always
build:ci --repo_env=ANDROID_HOME=
build:ci --repo_env=ANDROID_SDK_ROOT=
test:ci --build_tests_only

# codspeed-criterion-compat selects its instrumented implementation with this cfg.
build:codspeed --@rules_rust//rust/settings:extra_rustc_flag=--cfg=codspeed

# Optional developer-local overrides (registry mirrors, remote cache, etc.).
try-import %workspace%/user.bazelrc
