{
  "uid": "crabka-overview",
  "title": "Crabka — Overview",
  "tags": ["crabka", "overview"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      { "name": "ds", "type": "datasource", "query": "prometheus", "current": { "text": "Crabka Metrics", "value": "crabka-prom" }, "hide": 0 }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Fleet health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "stat", "title": "Services up",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Scrape targets reporting up=1 out of all configured.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(up)", "instant": true } ]
    },
    {
      "id": 3, "type": "stat", "title": "Services down",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "count(up == 0) or vector(0)", "instant": true } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Liveness (up) by service",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 } } },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}}" } ]
    },
    { "id": 10, "type": "row", "title": "Ingest rate by subsystem (req/s)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    {
      "id": 11, "type": "timeseries", "title": "Ingest req/s",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_metrics_ingest_requests_total[$__rate_interval]))", "legendFormat": "metrics" },
        { "refId": "B", "expr": "sum(rate(crabka_logs_ingest_requests_total[$__rate_interval]))", "legendFormat": "logs" },
        { "refId": "C", "expr": "sum(rate(crabka_traces_ingest_requests_total[$__rate_interval]))", "legendFormat": "traces" },
        { "refId": "D", "expr": "sum(rate(crabka_profiles_ingest_requests_total[$__rate_interval]))", "legendFormat": "profiles" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Query req/s",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_metrics_query_requests_total[$__rate_interval]))", "legendFormat": "metrics" },
        { "refId": "B", "expr": "sum(rate(crabka_logs_query_requests_total[$__rate_interval]))", "legendFormat": "logs" },
        { "refId": "C", "expr": "sum(rate(crabka_traces_query_requests_total[$__rate_interval]))", "legendFormat": "traces" },
        { "refId": "D", "expr": "sum(rate(crabka_profiles_query_requests_total[$__rate_interval]))", "legendFormat": "profiles" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Ingest error ratio by subsystem",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(crabka_metrics_ingest_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_metrics_ingest_requests_total[5m])), 1)) or vector(0)", "legendFormat": "metrics" },
        { "refId": "B", "expr": "(sum(rate(crabka_logs_ingest_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_logs_ingest_requests_total[5m])), 1)) or vector(0)", "legendFormat": "logs" },
        { "refId": "C", "expr": "(sum(rate(crabka_traces_ingest_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_traces_ingest_requests_total[5m])), 1)) or vector(0)", "legendFormat": "traces" },
        { "refId": "D", "expr": "(sum(rate(crabka_profiles_ingest_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_profiles_ingest_requests_total[5m])), 1)) or vector(0)", "legendFormat": "profiles" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Broker throughput (bytes in/out)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_topic_bytes_in_total[$__rate_interval]))", "legendFormat": "in" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_topic_bytes_out_total[$__rate_interval]))", "legendFormat": "out" }
      ]
    }
  ]
}
