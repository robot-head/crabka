{
  "uid": "crabka-demo",
  "title": "Crabka — Orders Demo",
  "tags": ["crabka", "demo", "orders"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      { "name": "ds", "type": "datasource", "query": "prometheus", "current": { "text": "Crabka Metrics", "value": "crabka-prom" }, "hide": 0 }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Order flow", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "stat", "title": "Orders produced /s",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Rate the produce role emits orders to the `orders` topic.",
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(rate(crabka_demo_orders_produced_total[$__rate_interval]))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Orders processed /s",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Rate the traced consumer processes orders (validate → enrich → fraud_check → fulfill).",
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(rate(crabka_demo_orders_processed_total[$__rate_interval]))" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Orders produced by category (/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum by (category) (rate(crabka_demo_orders_produced_total[$__rate_interval]))", "legendFormat": "{{category}}" } ]
    },
    { "id": 10, "type": "row", "title": "Business dimensions (labels)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    {
      "id": 11, "type": "timeseries", "title": "Produced by region (/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "targets": [ { "refId": "A", "expr": "sum by (region) (rate(crabka_demo_orders_produced_total[$__rate_interval]))", "legendFormat": "{{region}}" } ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Produced by payment method (/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "targets": [ { "refId": "A", "expr": "sum by (payment_method) (rate(crabka_demo_orders_produced_total[$__rate_interval]))", "legendFormat": "{{payment_method}}" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Order value p50 / p99 ($)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "min": 0 } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(crabka_demo_order_value_dollars_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(crabka_demo_order_value_dollars_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    { "id": 20, "type": "row", "title": "Processing pipeline", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },
    {
      "id": 21, "type": "timeseries", "title": "Processed by outcome (/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "fulfilled = shipped; fraud_rejected = high-value crypto order; anomalous = seeded zero-amount order.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (rate(crabka_demo_orders_processed_total[$__rate_interval]))", "legendFormat": "{{outcome}}" } ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Per-stage processing latency p99 (s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "p99 of each traced consumer stage — the same spans you see in the process_order trace waterfall.",
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(crabka_demo_process_stage_latency_seconds_bucket[5m])))", "legendFormat": "{{stage}}" } ]
    },
    {
      "id": 23, "type": "timeseries", "title": "End-to-end processing p50 / p99 (s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(crabka_demo_order_processing_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(crabka_demo_order_processing_latency_seconds_bucket[5m])))", "legendFormat": "p99" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(crabka_demo_produce_latency_seconds_bucket[5m])))", "legendFormat": "produce p99" }
      ]
    },
    { "id": 30, "type": "row", "title": "Top movers & risk", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 31, "type": "table", "title": "Top category × region (orders/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [ { "refId": "A", "expr": "topk(15, sum by (category, region) (rate(crabka_demo_orders_produced_total[$__rate_interval])))", "instant": true, "format": "table" } ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Fraud / anomaly rate (/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (rate(crabka_demo_orders_processed_total{outcome=~\"fraud_rejected|anomalous\"}[$__rate_interval]))", "legendFormat": "{{outcome}}" } ]
    }
  ]
}
