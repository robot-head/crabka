{
  "uid": "crabka-svc-profiles",
  "title": "Crabka — Profiles",
  "tags": ["crabka", "observability", "profiles"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      { "name": "ds", "type": "datasource", "query": "prometheus", "current": { "text": "Crabka Metrics", "value": "crabka-prom" }, "hide": 0 }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Service health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "timeseries", "title": "Up (1 = scrape OK) by role",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Per-process liveness. 0 means the profiles service's :9404 /metrics scrape failed.",
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 } } },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "up{job=~\"profiles-.*\"}", "legendFormat": "{{job}}" } ]
    },
    { "id": 10, "type": "row", "title": "Ingest (distributor)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 } },
    {
      "id": 11, "type": "timeseries", "title": "Ingest rate (req/s) by status",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(crabka_profiles_ingest_requests_total[$__rate_interval]))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Ingest throughput",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_profiles_ingest_bytes_total[$__rate_interval]))", "legendFormat": "bytes/s" },
        { "refId": "B", "expr": "sum(rate(crabka_profiles_ingest_items_total[$__rate_interval]))", "legendFormat": "profiles/s" }
      ]
    },
    {
      "id": 13, "type": "stat", "title": "Ingest error ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [ { "refId": "A", "expr": "(sum(rate(crabka_profiles_ingest_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_profiles_ingest_requests_total[5m])), 1)) or vector(0)", "instant": true } ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Ingest latency (p50 / p99, s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(crabka_profiles_ingest_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(crabka_profiles_ingest_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "WAL append failures (per s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [ { "refId": "A", "expr": "sum(rate(crabka_profiles_wal_append_failures_total[$__rate_interval]))", "legendFormat": "wal append failures" } ]
    },
    { "id": 20, "type": "row", "title": "Query (querier)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 } },
    {
      "id": 21, "type": "timeseries", "title": "Query rate (req/s) by route",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "targets": [ { "refId": "A", "expr": "sum by (route) (rate(crabka_profiles_query_requests_total[$__rate_interval]))", "legendFormat": "{{route}}" } ]
    },
    {
      "id": 22, "type": "stat", "title": "Query error ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "targets": [ { "refId": "A", "expr": "(sum(rate(crabka_profiles_query_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(crabka_profiles_query_requests_total[5m])), 1)) or vector(0)", "instant": true } ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Query p99 latency (s) by route",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, route) (rate(crabka_profiles_query_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" } ]
    }
  ]
}
