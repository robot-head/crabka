{
  "uid": "crabka-broker",
  "title": "Crabka — Broker",
  "tags": ["crabka", "kafka", "broker"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Crabka Metrics", "value": "crabka-prom" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "row", "title": "Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "stat", "title": "Active controller",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "1 when this broker is the active KRaft controller.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "No", "color": "red" }, "1": { "text": "Yes", "color": "green" } } } ], "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "max(crabka_broker_active_controller)" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Offline partitions",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Partitions with no leader. Should be 0.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(crabka_broker_offline_partitions_count)" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Under-replicated partitions",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Partitions whose ISR is smaller than the replica set. Should be 0.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(crabka_broker_under_replicated_partitions)" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Under-min-ISR partitions",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "description": "Partitions below min.insync.replicas — producers with acks=all are blocked.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(crabka_broker_under_min_isr_partition_count)" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Partitions led",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(crabka_broker_partitions_led)" } ]
    },
    {
      "id": 7, "type": "stat", "title": "Partitions total",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(crabka_broker_partitions_total)" } ]
    },
    {
      "id": 10, "type": "row", "title": "Throughput", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11, "type": "timeseries", "title": "Bytes in / out (B/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_topic_bytes_in_total[$__rate_interval]))", "legendFormat": "in" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_topic_bytes_out_total[$__rate_interval]))", "legendFormat": "out" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Messages in (msg/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [ { "refId": "A", "expr": "sum(rate(crabka_broker_messages_in_total[$__rate_interval]))", "legendFormat": "messages" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Produce / fetch requests (req/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_topic_produce_requests_total[$__rate_interval]))", "legendFormat": "produce" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_topic_fetch_requests_total[$__rate_interval]))", "legendFormat": "fetch" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Top topics by bytes in (B/s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [ { "refId": "A", "expr": "topk(10, sum by (topic) (rate(crabka_broker_topic_bytes_in_total[$__rate_interval])))", "legendFormat": "{{topic}}" } ]
    },
    {
      "id": 20, "type": "row", "title": "Replication & controller", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 21, "type": "timeseries", "title": "ISR shrinks / expands (per s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_isr_shrinks_total[$__rate_interval]))", "legendFormat": "shrinks" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_isr_expands_total[$__rate_interval]))", "legendFormat": "expands" }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Controller leader changes / unclean elections (per s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_controller_leader_changes_total[$__rate_interval]))", "legendFormat": "leader changes" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_unclean_leader_elections_total[$__rate_interval]))", "legendFormat": "unclean elections" }
      ]
    },
    {
      "id": 30, "type": "row", "title": "Audit (FedRAMP MLA)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 31, "type": "timeseries", "title": "Audit events vs write failures (per s)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(crabka_broker_audit_events_total[$__rate_interval]))", "legendFormat": "events" },
        { "refId": "B", "expr": "sum(rate(crabka_broker_audit_write_failures_total[$__rate_interval]))", "legendFormat": "write failures" },
        { "refId": "C", "expr": "sum(rate(crabka_broker_audit_records_dropped_total[$__rate_interval]))", "legendFormat": "dropped" }
      ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Audit spool depth / bytes",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "sum(crabka_broker_audit_spool_depth)", "legendFormat": "depth (records)" },
        { "refId": "B", "expr": "sum(crabka_broker_audit_spool_bytes)", "legendFormat": "bytes" }
      ]
    }
  ]
}
