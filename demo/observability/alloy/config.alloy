// ---------------- OTLP receive (traces + native metrics) ----------------
otelcol.receiver.otlp "in" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.exporter.prometheus.otlp_metrics.input]
		traces  = [otelcol.processor.batch.traces.input]
	}
}

// Convert OTLP metrics (for example RustFS native observability metrics) into
// Prometheus samples and remote-write them into Crabka Metrics. Keep metric
// names as emitted by the source so dashboards can use RustFS's documented
// rustfs_<subsystem>_<metric> names directly.
otelcol.exporter.prometheus "otlp_metrics" {
	forward_to = [prometheus.remote_write.crabka.receiver]

	add_metric_suffixes              = false
	include_scope_info               = false
	include_scope_labels             = false
	include_target_info              = false
	resource_to_telemetry_conversion = true
}

// Coalesce spans into fewer, larger exports so the distributor's per-request
// produce path is invoked less often and each request carries a full batch
// (drained into the WAL in ~one round-trip). Defense-in-depth alongside the
// distributor's concurrent produce_spans.
otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlphttp.traces.input]
	}
}

otelcol.exporter.otlphttp "traces" {
	client {
		endpoint = "http://traces-distributor:4318"
		headers  = {"X-Scope-OrgID" = "demo"}

		tls {
			insecure = true
		}
	}
}

// ---------------- Metrics: scrape every Crabka service's :9404 /metrics ----------------
// Every Crabka service exposes a Prometheus exporter on its admin port 9404
// (the broker via its metrics server; the four observability services via the
// shared profiling-admin server, across all roles). The `job` label carries the
// compose service name so dashboards/alerts can select per service+role. The
// demo apps are intentionally NOT scraped here — they expose pprof on 9404 but
// no /metrics, so a metrics scrape would 404 (up=0). They remain in the
// pyroscope scrape below for CPU profiles.
prometheus.scrape "crabka" {
	targets = [
		{__address__ = "broker:9404", job = "broker"},
		{__address__ = "metrics-distributor:9404", job = "metrics-distributor"},
		{__address__ = "metrics-querier:9404", job = "metrics-querier"},
		{__address__ = "metrics-compactor:9404", job = "metrics-compactor"},
		{__address__ = "traces-distributor:9404", job = "traces-distributor"},
		{__address__ = "traces-querier:9404", job = "traces-querier"},
		{__address__ = "traces-block-builder:9404", job = "traces-block-builder"},
		{__address__ = "logs-distributor:9404", job = "logs-distributor"},
		{__address__ = "logs-querier:9404", job = "logs-querier"},
		{__address__ = "logs-compactor:9404", job = "logs-compactor"},
		{__address__ = "profiles-distributor:9404", job = "profiles-distributor"},
		{__address__ = "profiles-querier:9404", job = "profiles-querier"},
		{__address__ = "profiles-block-builder:9404", job = "profiles-block-builder"},
	]
	scrape_interval = "15s"
	forward_to      = [prometheus.remote_write.crabka.receiver]
}

// Container-level runtime metrics for both Crabka and the supporting
// observability stack. cAdvisor contributes CPU, memory working set, RSS/cache,
// limits, throttling, network, and filesystem metrics labeled with Docker
// Compose service metadata.
prometheus.scrape "containers" {
	targets = [
		{__address__ = "cadvisor:8080", job = "cadvisor"},
	]
	scrape_interval = "15s"
	forward_to      = [prometheus.relabel.container_resources.receiver]
}

prometheus.relabel "container_resources" {
	forward_to = [prometheus.remote_write.crabka.receiver]

	rule {
		action        = "keep"
		source_labels = ["__name__"]
		regex         = "container_last_seen|container_cpu_usage_seconds_total|container_cpu_cfs_throttled_seconds_total|container_memory_working_set_bytes|container_memory_rss|container_memory_cache|container_spec_memory_limit_bytes|container_start_time_seconds|container_network_receive_bytes_total|container_network_transmit_bytes_total|container_fs_reads_bytes_total|container_fs_writes_bytes_total"
	}

	rule {
		action        = "keep"
		source_labels = ["container_label_com_docker_compose_project"]
		regex         = "crabka-observability-demo"
	}

	rule {
		action = "labelkeep"
		regex  = "__name__|job|instance|id|image|name|cpu|device|interface|container_label_com_docker_compose_project|container_label_com_docker_compose_service"
	}
}

prometheus.remote_write "crabka" {
	endpoint {
		url     = "http://metrics-distributor:4041/api/v1/push"
		headers = {"X-Scope-OrgID" = "demo"}
	}
}

// ---------------- Logs: tail container stdout → Loki push ----------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Map the Docker compose service name to the Loki service_name label so logs
// appear under a meaningful stream selector instead of "unknown_service".
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "crabka-observability-demo"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "job"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.crabka.receiver]
}

loki.write "crabka" {
	endpoint {
		url     = "http://logs-distributor:3100/loki/api/v1/push"
		headers = {"X-Scope-OrgID" = "demo"}
	}
}

// ---------------- Profiles: scrape Crabka :9404 pprof → Pyroscope ----------------
// Three scrape blocks keep target sets explicit. Crabka service binaries are
// built `--features heap-profiling` in the demo image, so they expose CPU and
// jemalloc heap at /debug/pprof/{profile,heap}. Demo app roles are CPU-only:
// they depend on Turso, which already defines a global allocator.
//
// `delta_profiling_duration = "5s"` keeps CPU profiles useful without
// near-continuous SIGPROF overhead; Alloy's default delta window is based on the
// scrape interval and would otherwise profile each process for almost all 60s.
pyroscope.scrape "crabka_services" {
	targets = [
		{__address__ = "broker:9404", service_name = "broker"},
		{__address__ = "metrics-distributor:9404", service_name = "metrics-distributor"},
		{__address__ = "traces-distributor:9404", service_name = "traces-distributor"},
		{__address__ = "logs-distributor:9404", service_name = "logs-distributor"},
		{__address__ = "profiles-distributor:9404", service_name = "profiles-distributor"},
		{__address__ = "schema-registry:9404", service_name = "schema-registry"},
	]
	scrape_interval          = "60s"
	delta_profiling_duration = "5s"

	profiling_config {
		profile.process_cpu {
			enabled = true
		}

		profile.memory {
			enabled = true
			path    = "/debug/pprof/heap"
		}

		profile.goroutine {
			enabled = false
		}

		profile.block {
			enabled = false
		}

		profile.mutex {
			enabled = false
		}
	}
	forward_to = [pyroscope.write.crabka.receiver]
}

// Demo apps: CPU only. They are not built with --features heap-profiling because
// the streams dependency graph already brings in Turso's global allocator.
pyroscope.scrape "demo_apps" {
	targets = [
		{__address__ = "demo-produce:9404", service_name = "demo-produce"},
		{__address__ = "demo-stream:9404", service_name = "demo-stream"},
		{__address__ = "demo-consume:9404", service_name = "demo-consume"},
	]
	scrape_interval          = "60s"
	delta_profiling_duration = "5s"

	profiling_config {
		profile.process_cpu {
			enabled = true
		}

		profile.memory {
			enabled = false
		}

		profile.goroutine {
			enabled = false
		}

		profile.block {
			enabled = false
		}

		profile.mutex {
			enabled = false
		}
	}
	forward_to = [pyroscope.write.crabka.receiver]
}

// CPU + jemalloc heap profiling for the compaction / block-builder / querier
// roles that the `crabka_services` block above (broker + distributors +
// schema-registry) does not cover. These binaries are built with
// `--features heap-profiling`, so /debug/pprof/heap exists. Worker CPU pprof
// is intentionally less frequent than service/distributor pprof: profiling a
// mostly-idle compactor for 5s every minute shows up as artificial steady CPU.
pyroscope.scrape "crabka_workers" {
	targets = [
		{__address__ = "metrics-compactor:9404", service_name = "metrics-compactor"},
		{__address__ = "metrics-querier:9404", service_name = "metrics-querier"},
		{__address__ = "traces-block-builder:9404", service_name = "traces-block-builder"},
		{__address__ = "traces-querier:9404", service_name = "traces-querier"},
		{__address__ = "logs-compactor:9404", service_name = "logs-compactor"},
		{__address__ = "logs-querier:9404", service_name = "logs-querier"},
		{__address__ = "profiles-block-builder:9404", service_name = "profiles-block-builder"},
		{__address__ = "profiles-querier:9404", service_name = "profiles-querier"},
	]
	scrape_interval          = "120s"
	delta_profiling_duration = "3s"

	profiling_config {
		profile.process_cpu {
			enabled = true
		}

		profile.memory {
			enabled = true
			path    = "/debug/pprof/heap"
		}

		profile.goroutine {
			enabled = false
		}

		profile.block {
			enabled = false
		}

		profile.mutex {
			enabled = false
		}
	}
	forward_to = [pyroscope.write.crabka.receiver]
}

pyroscope.write "crabka" {
	endpoint {
		url     = "http://profiles-distributor:4040"
		headers = {"X-Scope-OrgID" = "demo"}
	}
}
