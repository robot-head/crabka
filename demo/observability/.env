# Resource limits + workload size for the demo (see docker-compose.yml). These
# are HARD CAPS (memswap_limit == mem_limit in the compose, so a tier over its
# cap is OOM-killed + restarted, not left to swap-thrash). Defaults suit a
# ~16 GB / 8-core dev machine; steady-state usage is ~8-9 GiB, so ~12 GiB is the
# practical minimum host.
#
# SCALE UP (larger host): raise the caps below, and raise CRABKA_DEMO_ORDERS_PER_SEC
#   together with CRABKA_DISTRIBUTOR_MEM / CRABKA_COMPACTOR_MEM (ingest + compaction
#   grow with throughput).
# SCALE DOWN (small host): the distributors' ~1.5-1.7 GiB RSS is a near-fixed
#   jemalloc heap-profiling FLOOR, independent of workload, so do NOT shrink their
#   cap below ~2g while profiling is on. The real small-host lever is to disable
#   profiling — set MALLOC_CONF: "prof:false" in the x-otlp-env block (or rebuild
#   the image without --features heap-profiling) — which drops every Rust service's
#   RSS; then lower the caps.
# `cpus` caps above the host core count are simply non-binding.

# Kafka-compatible broker (central, bursty)
CRABKA_BROKER_MEM=2g
CRABKA_BROKER_CPUS=4

# Ingest distributors (logs/metrics/traces/profiles): WAL-write buffer. RSS is
# dominated by the ~1.5-1.7 GiB heap-profiling floor; keep the cap above it, and
# raise it in lockstep with CRABKA_DEMO_ORDERS_PER_SEC (buffering grows with
# throughput). This is the heaviest tier.
CRABKA_DISTRIBUTOR_MEM=3g
CRABKA_DISTRIBUTOR_CPUS=2

# Queriers (logs/metrics/traces/profiles): query working set (Arrow). 2g sits
# above the in-code 1.5 GB TraceQL concat guard, so a pathological wide query
# fails gracefully ("narrow your query") instead of OOM-killing the container;
# raise it if you routinely run very wide queries.
CRABKA_QUERIER_MEM=2g
CRABKA_QUERIER_CPUS=2

# Compactors / block-builders (logs/metrics/profiles): idle RSS is tiny
# (<0.1 GiB); 1g absorbs compaction/flush spikes. Raise with throughput.
CRABKA_COMPACTOR_MEM=1g
CRABKA_COMPACTOR_CPUS=2

# Trace block-builder: cold replay can transiently materialize/index hundreds
# of thousands of self-observed broker spans before steady state settles back
# below ~0.2 GiB. Keep a larger hard cap so a replay spike does not crash-loop,
# and keep trace flushes smaller than the library default to bound per-flush
# Arrow/index working sets.
CRABKA_TRACES_BLOCK_BUILDER_MEM=4g
CRABKA_TRACES_BLOCK_BUILDER_FLUSH_MAX_RECORDS=5000

# Schema registry
CRABKA_SCHEMA_REGISTRY_MEM=768m
CRABKA_SCHEMA_REGISTRY_CPUS=1

# RustFS (S3-compatible object store): cap bounds object-store cache and query bursts
CRABKA_RUSTFS_MEM=2g
CRABKA_RUSTFS_CPUS=2

# Alloy OTLP collector
CRABKA_ALLOY_MEM=512m
CRABKA_ALLOY_CPUS=1

# cAdvisor container resource exporter
CRABKA_CADVISOR_MEM=512m
CRABKA_CADVISOR_CPUS=1

# Grafana
CRABKA_GRAFANA_MEM=1g
CRABKA_GRAFANA_CPUS=2

# Demo workload apps (produce/stream/consume): 1g covers the Kafka Streams app
# (demo-stream), which bursts above idle on group rebalance / state-store build.
CRABKA_DEMO_MEM=1g
CRABKA_DEMO_CPUS=1

# One-shot setup/init containers (broker-format, rustfs-setup, topic-setup)
CRABKA_SETUP_MEM=512m
CRABKA_SETUP_CPUS=1

# Demo order throughput — the main workload knob. Raising it stresses the whole
# pipeline; raise CRABKA_DISTRIBUTOR_MEM (and CRABKA_COMPACTOR_MEM) in lockstep.
CRABKA_DEMO_ORDERS_PER_SEC=50
