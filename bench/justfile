# Crabka vs Strimzi benchmark recipes. Run from the repo root via
# `just -f bench/justfile <recipe>`, or `just <recipe>` after a `cd bench`.
#
# Two modes:
#   bench-ci       lightweight KinD-friendly: 1 broker RF=1, short scenarios.
#                  builds the bench-driver image via melange/apko and loads
#                  it into a `crabka-bench` kind cluster.
#   bench-cluster  assumes kubeconfig points at a real cluster. Runs the
#                  heavier matrix including 3-broker RF=3 and failover.
#
# Override the driver image with BENCH_DRIVER_IMAGE=... at the front.

set shell := ["bash", "-euo", "pipefail", "-c"]

repo_root := justfile_directory() / ".."
results_dir := repo_root / "bench" / "results"

# Default scenarios per mode (override by passing scenarios="a b c").
ci_scenarios       := "small-msg-saturate fixed-rate-latency"
cluster_scenarios  := "small-msg-saturate fixed-rate-latency large-msg fan-out mixed-acks failover high-partition-saturate high-partition-latency high-partition-fanout"

bench_driver_image := env_var_or_default("BENCH_DRIVER_IMAGE", "crabka-bench-driver:e2e")
strimzi_version    := env_var_or_default("STRIMZI_VERSION", "1.0.0")
# How many times the averaged recipes repeat the matrix (each repeat is a
# separate sample; the report averages them per (scenario, topology) cell).
runs               := env_var_or_default("RUNS", "10")

# ── Top-level ──────────────────────────────────────────────────────────────

default:
    @just --list

# Full CI smoke: build images, kind-up, install both operators, run CI
# scenarios on both stacks, tear down.
bench-ci: build-driver-image kind-up install-all
    just _run-matrix "1broker-rf1" "{{ci_scenarios}}"
    just bench-report

# Full cluster matrix. Assumes a kubeconfig context is already set.
bench-cluster: install-all
    just _run-matrix "3broker-rf3" "{{cluster_scenarios}}"
    just bench-report-failover

# 6-broker cluster matrix repeated `runs` times (default 10) for averaging.
# Each repeat tags its output files `-runNN` so nothing is clobbered; the
# report then averages every metric per (scenario, topology) cell. Assumes a
# kubeconfig context is set and the broker pool has >=6 nodes (the brokers
# anti-affinity one-per-node).
bench-cluster-6broker: install-all
    for i in $(seq 1 {{runs}}); do \
      export BENCH_RUN_TAG="$(printf -- '-run%02d' "$i")"; \
      echo "═══ repeat $i / {{runs}} (tag $BENCH_RUN_TAG) ═══"; \
      just _run-matrix "6broker-rf3" "{{cluster_scenarios}}"; \
    done
    just bench-report-failover

# Aggregate per-run JSON into a Markdown summary, graph-ready CSVs, a
# standalone Plotly report, and the website charts fragment:
#   SUMMARY.md      mean ± CV per (scenario, topology) cell
#   results.csv     one row per run (wide) — bars with run-to-run error bars
#   timeseries.csv  long format (run × time-offset × metric) — values over time
#   report.html     self-contained interactive report (bars + averaged series)
#   website fragment per-run + averaged throughput/CPU/memory, inlined by the
#                   `benchmark_charts` Zola shortcode on the benchmarks page
bench-report:
    cargo run --release -p crabka-bench-driver --bin crabka-bench-report -- \
        --input-dir {{results_dir}} \
        --out {{results_dir}}/SUMMARY.md \
        --csv {{results_dir}}/results.csv \
        --timeseries-csv {{results_dir}}/timeseries.csv \
        --html {{results_dir}}/report.html \
        --web-fragment {{repo_root}}/website/data/benchmarks/charts.html

# Aggregate and enforce failover quality. This exits non-zero unless failover
# cells prove Crabka recovered no slower than Kafka, with comparable message
# rate, drop, and latency-spike evidence.
bench-report-failover:
    cargo run --release -p crabka-bench-driver --bin crabka-bench-report -- \
        --input-dir {{results_dir}} \
        --out {{results_dir}}/SUMMARY.md \
        --csv {{results_dir}}/results.csv \
        --timeseries-csv {{results_dir}}/timeseries.csv \
        --html {{results_dir}}/report.html \
        --web-fragment {{repo_root}}/website/data/benchmarks/charts.html \
        --failover-gate

# Tear down operators and namespaces created by `just install-all`.
bench-clean:
    -kubectl delete namespace monitoring --ignore-not-found
    -kubectl delete namespace crabka-operator --ignore-not-found
    -kubectl delete namespace strimzi-system --ignore-not-found
    -bench/scripts/teardown.sh crabka
    -bench/scripts/teardown.sh kafka

# ── Building blocks (callable directly when iterating) ─────────────────────

install-all: install-strimzi install-crabka install-prometheus

install-strimzi:
    STRIMZI_VERSION={{strimzi_version}} bench/scripts/install-strimzi.sh

install-crabka:
    bench/scripts/install-crabka.sh

install-prometheus:
    bench/scripts/install-prometheus.sh

# Run one scenario × one stack. Useful for iteration:
#   just run crabka small-msg-saturate 1broker-rf1
run STACK SCENARIO TOPOLOGY="1broker-rf1":
    BENCH_DRIVER_IMAGE={{bench_driver_image}} \
        bench/scripts/run-scenario.sh {{STACK}} {{SCENARIO}} {{TOPOLOGY}}

# Build the bench-driver OCI image through the Bazel packaging graph.
build-driver-image:
    aspect run //packaging:bench_driver_image_load --bazel-flag=--config=ci

# Bring up a local KinD cluster sized for the bench. No-op if one already
# exists.
kind-up:
    @if kind get clusters 2>/dev/null | grep -q '^crabka-bench$'; then \
      echo "kind cluster 'crabka-bench' already exists"; \
    else \
      kind create cluster --name crabka-bench --image mirror.gcr.io/kindest/node:v1.30.0 --wait 60s; \
    fi
    @echo "loading bench-driver image into kind"
    docker load -i crabka-bench-driver.tar 2>&1 | tee /tmp/load.log
    loaded=$(sed -n 's/^Loaded image: //p' /tmp/load.log | head -1); \
        if [ "$loaded" != "{{bench_driver_image}}" ]; then \
            docker tag "$loaded" "{{bench_driver_image}}"; \
        fi; \
        kind load docker-image "{{bench_driver_image}}" --name crabka-bench

kind-down:
    -kind delete cluster --name crabka-bench

# ── Internal helpers ───────────────────────────────────────────────────────

# Run a matrix of (stack × scenario) and append all outputs to results_dir.
_run-matrix TOPOLOGY SCENARIOS:
    mkdir -p {{results_dir}}
    for scenario in {{SCENARIOS}}; do \
      for stack in crabka kafka; do \
        echo "═══ $stack / $scenario / {{TOPOLOGY}} ═══"; \
        BENCH_DRIVER_IMAGE={{bench_driver_image}} \
            bench/scripts/run-scenario.sh "$stack" "$scenario" "{{TOPOLOGY}}" \
            || echo "WARN: $stack/$scenario failed (continuing)"; \
        bench/scripts/teardown.sh "$stack"; \
      done; \
    done
