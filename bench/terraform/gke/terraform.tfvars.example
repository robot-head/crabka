# Copy to `terraform.tfvars` and edit. Only `project` is required; the rest
# default to the shape of the live `test-crabka-cluster` (see variables.tf).

project = "your-gcp-project" # the published run used "robot-head"

# Optional overrides (defaults shown):
# region                    = "us-central1"
# zone                      = "us-central1-b"
# cluster_name              = "test-crabka-cluster"
# broker_pool_machine_type  = "e2-standard-4"
# broker_pool_node_count    = 3
# default_pool_machine_type = "e2-standard-2"
# default_pool_node_count   = 3
# node_disk_gb              = 100
# release_channel           = "REGULAR"
# deletion_protection       = true   # set false to allow `terraform destroy`
