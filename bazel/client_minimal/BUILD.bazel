load("@rules_rs//rs:rust_library.bzl", "rust_library")

# Lean client facade. See lib.rs for the rationale; re-exported as
# @crabka//:client_minimal from //:BUILD.bazel.
#
# Its dependency closure is intentionally small: producer/consumer/admin/core +
# Avro/Protobuf serdes, with no polars/arrow/jsonschema.
rust_library(
    name = "client_minimal",
    srcs = ["lib.rs"],
    crate_name = "crabka_client_minimal",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/client-admin",
        "//crates/client-consumer",
        "//crates/client-core",
        "//crates/client-producer",
        "//crates/schema-serde:schema-serde-minimal",
    ],
)
